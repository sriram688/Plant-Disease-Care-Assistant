# PlantGuard AI - Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Database
# Default: SQLite in backend/data/plantguard.db
# PostgreSQL Example: postgresql://user:password@localhost:5432/plantguard
DATABASE_URL=sqlite:///backend/data/plantguard.db

# Model Selection
DEFAULT_MODEL_ARCHITECTURE=mobilenetv2
CONFIDENCE_THRESHOLD=0.50

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
